  {"name": "FIND with a blank (checked in Airtable 2026-10-29)", "formula": "IF(ISERROR(FIND(BLANK(),\"abc\")),\"ERR\",\"[\" & FIND(BLANK(),\"abc\") & \"]\") & \"|\" & IF(ISERROR(FIND(\"\",BLANK())),\"ERR\",\"[\" & FIND(\"\",BLANK()) & \"]\") & \"|\" & IF(ISERROR(FIND(\"a\",{t})),\"ERR\",\"[\" & FIND(\"a\",{t}) & \"]\") & \"|\" & IF(ISERROR(FIND(\"a\",{n})),\"ERR\",\"[\" & FIND(\"a\",{n}) & \"]\")", "record": {"t": null, "n": null}, "types": {"t": "text", "n": "number"}, "expected": "[0]|[]|[]|[]"},
  {"name": "FIND / SEARCH with empty text and blanks (checked in Airtable 2026-10-29)", "formula": "\"[\" & FIND(\"\", \"abc\") & \"]|[\" & FIND({t}, \"abc\") & \"]|[\" & FIND(\"a\", \"\") & \"]|[\" & FIND(\"\", \"\") & \"]|[\" & FIND({n}, \"abc\") & \"]|[\" & FIND(\"a\", \"\", 2) & \"]|[\" & FIND(\"z\", \"abc\") & \"]|[\" & FIND(BLANK(), \"\") & \"]|[\" & FIND(\"\", \"abc\", 3) & \"]|[\" & IF(ISERROR(SEARCH(\"a\", {t})),\"ERR\",SEARCH(\"a\", {t})) & \"]|[\" & IF(ISERROR(SEARCH(\"a\", \"\")),\"ERR\",SEARCH(\"a\", \"\")) & \"]|[\" & IF(ISERROR(SEARCH(BLANK(), \"abc\")),\"ERR\",SEARCH(BLANK(), \"abc\")) & \"]|[\" & IF(ISERROR(SEARCH(\"\", \"abc\")),\"ERR\",SEARCH(\"\", \"abc\")) & \"]|[\" & IF(ISERROR(SEARCH(\"a\", {n})),\"ERR\",SEARCH(\"a\", {n})) & \"]|[\" & (FIND(\"a\", \"\") + 0) & \"]|[\" & (FIND(\"a\", \"\") = BLANK()) & \"]|[\" & IF(ISERROR(FIND(\"a\", 5)),\"ERR\",FIND(\"a\", 5)) & \"]|[\" & IF(ISERROR(FIND(5, \"a5\")),\"ERR\",FIND(5, \"a5\")) & \"]\"", "record": {"t": null, "n": null}, "types": {"t": "text", "n": "number"}, "expected": "[1]|[1]|[]|[]|[0]|[]|[0]|[]|[3]|[0]|[0]|[ERR]|[1]|[ERR]|[0]|[TRUE]|[ERR]|[2]"},
  {"name": "FIND reads a number to find as text; booleans: unchecked (checked in Airtable 2026-10-29)", "formula": "\"[\" & IF(ISERROR(FIND(TRUE(), \"aTRUE\")),\"ERR\",FIND(TRUE(), \"aTRUE\")) & \"]|[\" & IF(ISERROR(SEARCH(5, \"a5\")),\"ERR\",SEARCH(5, \"a5\")) & \"]|[\" & IF(ISERROR(FIND(1.5, \"x1.5\")),\"ERR\",FIND(1.5, \"x1.5\")) & \"]|[\" & IF(ISERROR(FIND(0, \"a0\")),\"ERR\",FIND(0, \"a0\")) & \"]|[\" & IF(ISERROR(FIND({c}, \"abc\")),\"ERR\",FIND({c}, \"abc\")) & \"]|[\" & IF(ISERROR(FIND(\"a\", {c})),\"ERR\",FIND(\"a\", {c})) & \"]|[\" & IF(ISERROR(FIND(FALSE(), \"FALSE\")),\"ERR\",FIND(FALSE(), \"FALSE\")) & \"]|[\" & IF(ISERROR(FIND(5, \"a5\", 3)),\"ERR\",FIND(5, \"a5\", 3)) & \"]|[\" & IF(ISERROR(SEARCH(TRUE(), \"aTRUE\")),\"ERR\",SEARCH(TRUE(), \"aTRUE\")) & \"]\"", "record": {"c": false}, "expected": "[0]|[ERR]|[2]|[2]|[1]|[]|[0]|[0]|[ERR]"},
