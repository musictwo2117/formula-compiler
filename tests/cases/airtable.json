  {"name": "!= keeps a real blank apart from \"\" and 0 (checked in Airtable 2026-10-29)", "formula": "({n} != 0) & \"|\" & (BLANK() != 0) & \"|\" & (BLANK() != \"\") & \"|\" & ({n} != {n}) & \"|\" & ({n} < \"\") & \"|\" & ({n} >= \"\") & \"|\" & ({n} <= 0) & \"|\" & ({n} = \"a\") & \"|\" & ({n} = \"0\") & \"|\" & ({n} != \"a\") & \"|\" & ({t} != 0) & \"|\" & ({c} != 0) & \"|\" & ({n} != BLANK()) & \"|\" & ({t} != BLANK()) & \"|\" & ({c} != BLANK()) & \"|\" & ({cur} != \"\") & \"|\" & ({n} != {t}) & \"|\" & (0 != BLANK()) & \"|\" & (\"\" != BLANK()) & \"|\" & ({n} = \" \") & \"|\" & (\"\" = {n}) & \"|\" & (\"\" != {n})", "record": {"n": null, "t": null, "c": false, "cur": null}, "types": {"n": "number", "t": "text", "cur": "number"}, "expected": "TRUE|TRUE|TRUE|FALSE|FALSE|TRUE|TRUE|FALSE|FALSE|TRUE|FALSE|FALSE|FALSE|TRUE|TRUE|TRUE|TRUE|TRUE|TRUE|FALSE|TRUE|TRUE"},
  {"name": "a real blank in text functions and against text: unchecked (checked in Airtable 2026-10-29)", "formula": "IF(ISERROR(LEN(BLANK())),\"ERR\",LEN(BLANK())) & \"|\" & IF(ISERROR(LEN(IF(0,\"x\"))),\"ERR\",LEN(IF(0,\"x\"))) & \"|\" & IF(ISERROR(UPPER({n})),\"ERR\",\"[\" & UPPER({n}) & \"]\") & \"|\" & IF(ISERROR(LEN({n} & \"\")),\"ERR\",LEN({n} & \"\")) & \"|\" & ({n} <= \"a\") & \"|\" & (BLANK() < \"a\") & \"|\" & ({n} > \"-1\") & \"|\" & (BLANK() < \"1\") & \"|\" & ({t} < \"a\") & \"|\" & ({c} < \"a\") & \"|\" & (BLANK() = \"\") & \"|\" & (\"a\" > {n}) & \"|\" & IF(ISERROR(BLANK()*2),\"ERR\",BLANK()*2) & \"|\" & IF(ISERROR(LEN({c} & \"\")),\"ERR\",LEN({c} & \"\")) & \"|\" & IF(ISERROR(LEN(T({n}))),\"ERR\",LEN(T({n})))", "record": {"n": null, "t": null, "c": false}, "types": {"n": "number", "t": "text"}, "expected": "ERR|ERR|ERR|0|FALSE|FALSE|TRUE|TRUE|TRUE|TRUE|TRUE|FALSE|0|0|0"},
  {"name": "a real blank in text functions and against text: checked (checked in Airtable 2026-10-29)", "formula": "IF(ISERROR(LEN(BLANK())),\"ERR\",LEN(BLANK())) & \"|\" & IF(ISERROR(LEN(IF(0,\"x\"))),\"ERR\",LEN(IF(0,\"x\"))) & \"|\" & IF(ISERROR(UPPER({n})),\"ERR\",\"[\" & UPPER({n}) & \"]\") & \"|\" & IF(ISERROR(LEN({n} & \"\")),\"ERR\",LEN({n} & \"\")) & \"|\" & ({n} <= \"a\") & \"|\" & (BLANK() < \"a\") & \"|\" & ({n} > \"-1\") & \"|\" & (BLANK() < \"1\") & \"|\" & ({t} < \"a\") & \"|\" & ({c} < \"a\") & \"|\" & (BLANK() = \"\") & \"|\" & (\"a\" > {n}) & \"|\" & IF(ISERROR(BLANK()*2),\"ERR\",BLANK()*2) & \"|\" & IF(ISERROR(LEN({c} & \"\")),\"ERR\",LEN({c} & \"\")) & \"|\" & IF(ISERROR(LEN(T({n}))),\"ERR\",LEN(T({n})))", "record": {"n": null, "t": null, "c": true}, "types": {"n": "number", "t": "text"}, "expected": "ERR|ERR|ERR|0|FALSE|FALSE|TRUE|TRUE|TRUE|FALSE|TRUE|FALSE|0|4|0"},
  {"name": "BLANK() in text functions (checked in Airtable 2026-10-29)", "formula": "IF(ISERROR(LOWER(BLANK())),\"ERR\",\"[\" & LOWER(BLANK()) & \"]\") & \"|\" & IF(ISERROR(TRIM(BLANK())),\"ERR\",\"[\" & TRIM(BLANK()) & \"]\") & \"|\" & IF(ISERROR(LEFT(BLANK(),1)),\"ERR\",\"[\" & LEFT(BLANK(),1) & \"]\") & \"|\" & IF(ISERROR(RIGHT(BLANK(),1)),\"ERR\",\"[\" & RIGHT(BLANK(),1) & \"]\") & \"|\" & IF(ISERROR(SUBSTITUTE(BLANK(),\"a\",\"b\")),\"ERR\",\"[\" & SUBSTITUTE(BLANK(),\"a\",\"b\") & \"]\") & \"|\" & IF(ISERROR(REPLACE(BLANK(),1,1,\"x\")),\"ERR\",\"[\" & REPLACE(BLANK(),1,1,\"x\") & \"]\") & \"|\" & IF(ISERROR(SEARCH(\"a\",BLANK())),\"ERR\",\"[\" & SEARCH(\"a\",BLANK()) & \"]\") & \"|\" & IF(ISERROR(SUBSTITUTE(\"abc\",\"a\",BLANK())),\"ERR\",\"[\" & SUBSTITUTE(\"abc\",\"a\",BLANK()) & \"]\") & \"|\" & IF(ISERROR(CONCATENATE(BLANK(),\"x\")),\"ERR\",\"[\" & CONCATENATE(BLANK(),\"x\") & \"]\") & \"|\" & IF(ISERROR(VALUE(BLANK())),\"ERR\",\"[\" & VALUE(BLANK()) & \"]\") & \"|\" & IF(ISERROR(LEN(T(5))),\"ERR\",LEN(T(5))) & \"|\" & IF(ISERROR(LEN(T(BLANK()))),\"ERR\",LEN(T(BLANK())))", "expected": "ERR|ERR|ERR|[]|[]|ERR|ERR|ERR|[x]|ERR|0|0"},
