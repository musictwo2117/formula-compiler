  {"name": "checkbox operators: checked (checked in Airtable 2026-10-29)", "formula": "({c}+1) & \"|\" & IF(ISERROR({c}*2),\"ERR\",{c}*2) & \"|\" & IF(ISERROR(LEN({c})),\"ERR\",LEN({c})) & \"|\" & ({c}=\"\") & \"|\" & ({c}!=\"\") & \"|\" & ({c}=1) & \"|\" & ({c}=TRUE()) & \"|\" & {c} & \"|\" & IF({c},\"t\",\"f\") & \"|\" & COUNT({c}) & \"|\" & COUNTA({c}) & \"|\" & ({c}=\"1\") & \"|\" & ({c}!=0) & \"|\" & IF(ISERROR({c}/2),\"ERR\",{c}/2) & \"|\" & ({c}=FALSE()) & \"|\" & NOT({c})", "record": {"c": true}, "expected": "2|2|ERR|FALSE|TRUE|TRUE|TRUE|TRUE|t|0|1|TRUE|TRUE|0.5|FALSE|FALSE"},
