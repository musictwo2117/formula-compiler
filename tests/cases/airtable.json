  {"name": "blank number or currency field: + - * / & = != < IF LEN NOT SUM AVERAGE T (checked in Airtable 2026-10-29)", "formula": "\"[\" & ({n}+1) & \"|\" & ({n}-1) & \"|\" & (-{n}) & \"|\" & IF(ISERROR({n}*2),\"ERR\",{n}*2) & \"|\" & IF(ISERROR({n}/2),\"ERR\",{n}/2) & \"|\" & {n} & \"|\" & ({n}=\"\") & \"|\" & ({n}=0) & \"|\" & ({n}=BLANK()) & \"|\" & ({n}!=\"\") & \"|\" & ({n}<1) & \"|\" & ({n}>-1) & \"|\" & IF({n},\"t\",\"f\") & \"|\" & IF(ISERROR(LEN({n})),\"ERR\",LEN({n})) & \"|\" & NOT({n}) & \"|\" & ({n}=FALSE()) & \"|\" & SUM({n},1) & \"|\" & AVERAGE({n},2) & \"|\" & T({n}) & \"]\"", "record": {"n": null}, "types": {"n": "number"}, "expected": "[1|-1|0|0|0||TRUE|TRUE|TRUE|TRUE|TRUE|TRUE|f|ERR|TRUE|TRUE|1|2|]"},
  {"name": "blank text, long text or single select field (checked in Airtable 2026-10-29)", "formula": "\"[\" & ({t}+1) & \"|\" & ({t}-1) & \"|\" & (-{t}) & \"|\" & IF(ISERROR({t}*2),\"ERR\",{t}*2) & \"|\" & IF(ISERROR({t}/2),\"ERR\",{t}/2) & \"|\" & {t} & \"|\" & ({t}=\"\") & \"|\" & ({t}=0) & \"|\" & ({t}=BLANK()) & \"|\" & ({t}!=\"\") & \"|\" & ({t}<1) & \"|\" & ({t}>-1) & \"|\" & IF({t},\"t\",\"f\") & \"|\" & IF(ISERROR(LEN({t})),\"ERR\",LEN({t})) & \"|\" & NOT({t}) & \"|\" & ({t}=FALSE()) & \"|\" & SUM({t},1) & \"|\" & AVERAGE({t},2) & \"|\" & T({t}) & \"]\"", "record": {"t": null}, "types": {"t": "text"}, "expected": "[1|-1|0|ERR|ERR||TRUE|TRUE|TRUE|FALSE|TRUE|TRUE|f|0|TRUE|TRUE|1|2|]"},
  {"name": "unchecked checkbox acts as empty text (checked in Airtable 2026-10-29)", "formula": "\"[\" & ({c}+1) & \"|\" & ({c}-1) & \"|\" & (-{c}) & \"|\" & IF(ISERROR({c}*2),\"ERR\",{c}*2) & \"|\" & IF(ISERROR({c}/2),\"ERR\",{c}/2) & \"|\" & {c} & \"|\" & ({c}=\"\") & \"|\" & ({c}=0) & \"|\" & ({c}=BLANK()) & \"|\" & ({c}!=\"\") & \"|\" & ({c}<1) & \"|\" & ({c}>-1) & \"|\" & IF({c},\"t\",\"f\") & \"|\" & IF(ISERROR(LEN({c})),\"ERR\",LEN({c})) & \"|\" & NOT({c}) & \"|\" & ({c}=FALSE()) & \"|\" & SUM({c},1) & \"|\" & AVERAGE({c},2) & \"|\" & T({c}) & \"]\"", "record": {"c": false}, "expected": "[1|-1|0|ERR|ERR||TRUE|TRUE|TRUE|FALSE|TRUE|TRUE|f|0|TRUE|TRUE|1|2|]"},
  {"name": "unchecked checkbox read as null (checked in Airtable 2026-10-29)", "formula": "\"[\" & ({c}+1) & \"|\" & ({c}-1) & \"|\" & (-{c}) & \"|\" & IF(ISERROR({c}*2),\"ERR\",{c}*2) & \"|\" & IF(ISERROR({c}/2),\"ERR\",{c}/2) & \"|\" & {c} & \"|\" & ({c}=\"\") & \"|\" & ({c}=0) & \"|\" & ({c}=BLANK()) & \"|\" & ({c}!=\"\") & \"|\" & ({c}<1) & \"|\" & ({c}>-1) & \"|\" & IF({c},\"t\",\"f\") & \"|\" & IF(ISERROR(LEN({c})),\"ERR\",LEN({c})) & \"|\" & NOT({c}) & \"|\" & ({c}=FALSE()) & \"|\" & SUM({c},1) & \"|\" & AVERAGE({c},2) & \"|\" & T({c}) & \"]\"", "record": {"c": null}, "types": {"c": "boolean"}, "expected": "[1|-1|0|ERR|ERR||TRUE|TRUE|TRUE|FALSE|TRUE|TRUE|f|0|TRUE|TRUE|1|2|]"},
  {"name": "checked checkbox (checked in Airtable 2026-10-29)", "formula": "\"[\" & ({c}+1) & \"|\" & ({c}-1) & \"|\" & (-{c}) & \"|\" & IF(ISERROR({c}*2),\"ERR\",{c}*2) & \"|\" & IF(ISERROR({c}/2),\"ERR\",{c}/2) & \"|\" & {c} & \"|\" & ({c}=\"\") & \"|\" & ({c}=0) & \"|\" & ({c}=BLANK()) & \"|\" & ({c}!=\"\") & \"|\" & ({c}<1) & \"|\" & ({c}>-1) & \"|\" & IF({c},\"t\",\"f\") & \"|\" & IF(ISERROR(LEN({c})),\"ERR\",LEN({c})) & \"|\" & NOT({c}) & \"|\" & ({c}=FALSE()) & \"|\" & SUM({c},1) & \"|\" & AVERAGE({c},2) & \"|\" & T({c}) & \"]\"", "record": {"c": true}, "expected": "[2|0|-1|2|0.5|TRUE|FALSE|FALSE|FALSE|TRUE|FALSE|TRUE|t|ERR|FALSE|FALSE|2|2|]"},
